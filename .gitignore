# Foundry build output. Regenerated by `forge build`; never committed, so that a
# clone builds from source rather than trusting an artifact somebody uploaded.
out/
cache/
broadcast/

# Local environment. This repository needs no secrets to build or test; BASE_RPC_URL
# is the only variable it reads, and only for the opt-in fork tests.
.env
.env.*

# Editor and tooling scratch
.omc/
.DS_Store
